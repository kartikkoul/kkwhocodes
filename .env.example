# Public site URL (SEO: canonical, OG, sitemap, JSON-LD). Use your production domain.
# SITE_URL=https://yoursite.com
# NEXT_PUBLIC_SITE_URL=https://yoursite.com

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: inbox to receive contact form submissions (defaults to GMAIL_USER)
# CONTACT_TO_EMAIL=your@gmail.com

# Cloudflare Turnstile (free bot protection) — https://dash.cloudflare.com/?to=/:account/turnstile
# Dev test keys (always pass):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
